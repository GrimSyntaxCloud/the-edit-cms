{
  "platform": { "apiRuntime": "node:22" },
  "routes": [
    { "route": "/", "rewrite": "/api/site/home" },
    { "route": "/api.php", "rewrite": "/api/site/api.php" },
    { "route": "/image.php", "rewrite": "/api/site/image.php" },
    { "route": "/export.php", "rewrite": "/api/site/export.php" }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
