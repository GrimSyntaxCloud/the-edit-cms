<% const entry=item||{}; const field=(name)=>form[name]??entry[name]??''; const isDesk=['desk','edit','pages','page-edit','import','users','user-edit'].includes(page); %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="A fictional publication and a working editorial CMS with isolated demo workspaces."><title>The Edit · Stories, thoughtfully published</title><link rel="stylesheet" href="/style.css"></head><body class="<%=isDesk?'desk-mode':'publication-mode'%> page-<%=page%>">
<a class="skip-link" href="#main">Skip to content</a><div class="topline"><span>INDEPENDENT IDEAS. SHARED WELL.</span><span>RESTORED COURSEWORK · FICTIONAL DEMO</span></div><header><a class="brand" href="/" aria-label="The Edit home">THE EDIT<span>INDEPENDENT IDEAS / 01</span></a><nav aria-label="Main navigation"><a href="/" <%=page==='home'?'aria-current=page':''%>>Latest stories</a><a href="/?page=content&slug=about" <%=page==='content'?'aria-current=page':''%>>About</a><a href="/?page=widget" <%=page==='widget'?'aria-current=page':''%>>News widget</a><a class="nav-button" href="/?page=desk"><%=user?'Editorial desk ↗':'Try the editorial desk ↗'%></a></nav></header>
<main id="main"><% if(error){ %><p class="notice error" role="alert"><%=error%></p><% } %><% if(notice){ %><p class="notice" role="status"><%=notice%></p><% } %>
<% if(user){ %><div class="workspace-note"><span>PRIVATE DEMO WORKSPACE · <%=user.name%> / <%=user.role%></span><span>Automatically clears <time datetime="<%=expiry%>"><%=expiry.replace('T',' ').slice(0,16)%> UTC</time></span></div><% } %>
<% if(page==='home'){ %><section class="masthead"><div class="edition"><span>ISSUE 001 / THE OPENING EDITION</span><span>DESIGN. CULTURE. COMMUNITY.</span></div><h1>THE EDIT<span aria-hidden="true">✳</span></h1><div class="masthead-bottom"><p>Worth a closer look.<br><strong>A different point of view.</strong></p><span class="issue-mark">A PUBLICATION<br>WITH A WORKING CMS ↘</span></div></section>
<% const lead=articles[0]; if(lead){ %><div class="front-page"><section class="lead"><a class="feature-visual" href="/?page=article&id=<%=lead.id%>" aria-label="Read <%=lead.title%>"><% if(lead.image){ %><img src="<%=imageUrl(lead.image)%>" alt="Editorial image for the lead story"><% }else{ %><svg viewBox="0 0 900 570" role="img" aria-label="Original graphic of a folded newspaper, cobalt printing marks and an orange editorial annotation"><defs><pattern id="editor-grid" width="45" height="45" patternUnits="userSpaceOnUse"><path d="M45 0H0V45" fill="none" stroke="#fff" stroke-opacity=".13"/></pattern></defs><path fill="#2447f5" d="M0 0h900v570H0z"/><path fill="url(#editor-grid)" d="M0 0h900v570H0z"/><g class="news-sheet" transform="translate(235 48) rotate(-9 235 245)"><path d="M20 20h465v470H20z" fill="#10208b" opacity=".6"/><path d="M0 0h465v470H0z" fill="#fff"/><path d="M0 0h465v42H0z" fill="#10161d"/><path d="M23 22h130m227 0h62" stroke="#fff" stroke-width="3"/><text x="22" y="133" fill="#10161d" font-family="Arial,Helvetica,sans-serif" font-size="91" font-weight="900" letter-spacing="-8">THE EDIT</text><path d="M24 157h417" stroke="#111" stroke-width="7"/><path d="M24 170h417" stroke="#111"/><path d="M24 192h204v181H24z" fill="#2447f5"/><text x="39" y="345" font-family="Arial,Helvetica,sans-serif" font-size="170" font-weight="900" fill="#fff">E</text><path d="M250 200h185m-185 20h185m-185 20h155m-155 43h185m-185 20h185m-185 20h150m-150 42h185M24 399h417M24 416h417M24 433h275" stroke="#7f8993" stroke-width="4"/><path d="M465 0v470H361c64-38 96-152 104-470Z" fill="#e3e8ef"/></g><path d="M96 400c20-69 104-102 153-58 51 47-15 118-91 93-66-21-69-92-1-122" fill="none" stroke="#ff9065" stroke-width="13" stroke-linecap="round"/><path d="M706 102v76m-38-38h76" stroke="#ff9065" stroke-width="14"/><text x="33" y="43" fill="#fff" font-family="monospace" font-size="13">PRINT IS A START. IDEAS GO FURTHER.</text><text x="680" y="536" fill="#fff" font-family="monospace" font-size="12">01 / LOOK CLOSER</text></svg><% } %><span class="visual-caption">THE BIG READ <b aria-hidden="true">↗</b></span></a><div class="lead-copy"><p class="eyebrow">FEATURED STORY / 01</p><h2><a href="/?page=article&id=<%=lead.id%>"><%=lead.title%></a></h2><p><%=lead.content.replace(/\n/g,' ').slice(0,165)%>…</p><div class="story-meta"><span><%=lead.author%></span><time><%=lead.date%></time><a href="/?page=article&id=<%=lead.id%>">Read story ↗</a></div></div></section><aside class="issue-rail" aria-labelledby="in-this-issue"><h2 id="in-this-issue">IN THIS ISSUE <span>↓</span></h2><% articles.slice(1,4).forEach((a,i)=>{ %><article class="rail-story"><span class="story-number">0<%=i+2%></span><p class="eyebrow">NOTES & OBSERVATIONS</p><h3><a href="/?page=article&id=<%=a.id%>"><%=a.title%></a></h3><p class="byline"><%=a.author%> · <%=a.date%></p></article><% }); %><div class="rail-note"><span class="annotation" aria-hidden="true">✳</span><h3>THINK IT.<br>WRITE IT.<br>PUBLISH IT.</h3><p>There’s a working editorial desk behind this publication.</p><a href="/?page=desk">Take a look inside ↗</a></div><a class="widget-link" href="/?page=widget">THE LATEST, ANYWHERE.<span>Explore the news widget ↗</span></a></aside></div><% } %>
<% if(articles.length>4){ %><section class="more-stories"><div class="section-title"><h2>MORE TO THE STORY.</h2><span>FROM THE EDITORIAL DESK</span></div><% articles.slice(4).forEach((a,i)=>{ %><article><span class="story-number"><%=String(i+5).padStart(2,'0')%></span><h3><a href="/?page=article&id=<%=a.id%>"><%=a.title%></a></h3><span class="byline"><%=a.author%> · <%=a.date%></span><a href="/?page=article&id=<%=a.id%>" aria-label="Read <%=a.title%>">↗</a></article><% }); %></section><% } %>
<section class="try-desk"><div><p class="eyebrow">THE OTHER SIDE OF THE BYLINE</p><h2>DON’T JUST READ<br>THE NEXT ISSUE.<br><em>MAKE IT.</em></h2></div><div class="desk-invitation"><p>Create your own editorial workspace. Write a story, build a page, bring in a collection, and give your fictional team a seat at the desk.</p><div class="capability-list"><span>01 / STORIES & PAGES</span><span>02 / IMAGES & BYLINES</span><span>03 / PEOPLE & ROLES</span><span>04 / IMPORT & EXPORT</span></div><a class="button" href="/?page=<%=hasWorkspace?'login':'start'%>"><%=hasWorkspace?'Return to your workspace':'Start an editorial workspace'%> ↗</a><p class="hint">Your private demo clears after 96 hours. The original sample stories stay.</p></div></section>
<% } else if(page==='article'){ %><article class="article"><p class="eyebrow">THE EDIT / STORIES<%=entry.isSeed?' / READ-ONLY SAMPLE':''%></p><h1><%=entry.title%></h1><p class="byline">BY <%=entry.author%> · <%=entry.date%></p><% if(entry.image){ %><img src="<%=imageUrl(entry.image)%>" alt="Editorial image"><% } %><div class="body-copy preserved-text"><%=entry.content%></div><% if(user){ %><a class="read-link" href="/?page=edit&<%=entry.isSeed?'copy':'id'%>=<%=entry.id%>"><%=entry.isSeed?'Copy to workspace':'Edit story'%> ↗</a><% } %></article>
<% } else if(page==='content'){ %><article class="article"><p class="eyebrow"><%=entry.title%><%=entry.isSeed?' / READ-ONLY SAMPLE':''%></p><h1><%=entry.heading%></h1><% if(entry.image){ %><img src="<%=imageUrl(entry.image)%>" alt="Editorial image"><% } %><div class="body-copy preserved-text"><%=entry.content%></div></article>
<% } else if(page==='widget'){ %><section class="article"><p class="eyebrow">THE REUSABLE NEWS WIDGET</p><h1>Fresh from<br><em>the desk.</em></h1><div class="widget"><% articles.slice(0,5).forEach(a=>{ %><a href="/?page=article&id=<%=a.id%>"><small><%=a.date%></small><h3><%=a.title%> ↗</h3></a><% }); %></div><p>Also available as <a class="read-link" href="/api.php?type=articles">structured JSON ↗</a></p></section>
<% } else if(page==='login'||page==='start'){const starting=page==='start'; %><section class="login-layout"><div><p class="eyebrow">BEHIND THE BYLINES</p><h1>Good stories<br>start <em>here.</em></h1><p>Your space to write, publish and keep everything in order.</p><div class="demo-explanation"><strong>Your own corner of the newsroom.</strong><p>Each visitor gets an isolated workspace. Only people you create inside your workspace can sign in to it. Use fictional details; this is a public portfolio demo.</p><p>Your workspace, accounts, sessions and uploads clear 96 hours after creation. Saving or signing in does not extend that deadline. The original sample stories are read-only and remain available.</p></div></div><div><% if(starting||hasWorkspace){ %><form method="post" class="panel"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="<%=starting?'start':'login'%>"><h2><%=starting?'Your first edition.':'Welcome back.'%></h2><label>Username<input name="name" required minlength="3" maxlength="60" autocomplete="username"></label><label>Password<input type="password" name="password" required minlength="12" maxlength="256" autocomplete="<%=starting?'new-password':'current-password'%>"></label><% if(starting){ %><p class="hint">Choose a unique demo password with at least 12 characters. This creates your workspace administrator. You can add editor accounts from the People screen.</p><% } %><button><%=starting?'Create my workspace':'Open the desk'%> ↗</button></form><% } else { %><div class="panel"><h2>A blank page awaits.</h2><p>No active workspace was found in this browser.</p><a class="button" href="/?page=start">Start a demo workspace ↗</a></div><% } %><p class="hint"><% if(starting&&hasWorkspace){ %>Starting another workspace does not delete the previous one, but this browser will switch to the new workspace.<% } else if(!starting&&hasWorkspace){ %>Forgot the demo credentials? <a href="/?page=start">Start a fresh workspace</a>. Existing data still expires at its original deadline.<% } %></p></div></section>
<% } else if(isDesk){ const activeSection=['edit','desk'].includes(page)?'desk':(['pages','page-edit'].includes(page)?'pages':(['users','user-edit'].includes(page)?'users':'import')); const deskTitles={desk:'THE STORY DESK.',edit:entry.id?'REFINE THE STORY.':'WRITE THE NEXT ONE.',pages:'BEYOND THE BYLINE.','page-edit':'BUILD A PAGE.',import:'BRING YOUR WORDS.',users:'THE PEOPLE.','user-edit':'A SEAT AT THE DESK.'}; %>
<div class="workspace-shell"><aside class="workspace-rail"><a class="rail-brand" href="/?page=desk">THE EDIT<span>EDITORIAL WORKSPACE</span></a><p class="rail-label">YOUR PUBLISHING TOOLS</p><nav class="desk-nav" aria-label="Workspace navigation"><a href="/?page=desk" <%=activeSection==='desk'?'aria-current=page':''%>><span>01</span> Stories <b>↗</b></a><a href="/?page=pages" <%=activeSection==='pages'?'aria-current=page':''%>><span>02</span> Pages <b>↗</b></a><a href="/?page=import" <%=activeSection==='import'?'aria-current=page':''%>><span>03</span> Import & export <b>↗</b></a><% if(user.role==='admin'){ %><a href="/?page=users" <%=activeSection==='users'?'aria-current=page':''%>><span>04</span> People <b>↗</b></a><% } %></nav><div class="rail-workspace-info"><span class="status-dot" aria-hidden="true"></span><strong>YOUR OWN NEWSROOM.</strong><p>Your stories and changes stay in this private workspace.</p><span class="deadline-label">96-HOUR DEMO<br>EDITS DO NOT RESET THE CLOCK.</span></div><a class="back-publication" href="/">View the publication ↗</a></aside><section class="workspace-body"><section class="desk-heading"><div><p class="eyebrow">EDITORIAL WORKSPACE / <%=activeSection==='desk'?'STORIES':activeSection.toUpperCase()%></p><h1><%=deskTitles[page]%></h1></div><form method="post"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="logout"><button class="quiet">Sign out ↗</button></form></section>
<% if(page==='desk'){ %><div class="toolbar"><form method="get"><input type="hidden" name="page" value="desk"><label class="sr-only" for="search">Search stories</label><input id="search" name="search" placeholder="Search title or author" value="<%=search%>" maxlength="200"><label class="sr-only" for="sort">Sort stories</label><select id="sort" name="sort"><option value="newest">Newest first</option><option value="oldest" <%=sort==='oldest'?'selected':''%>>Oldest first</option></select><button class="quiet">Search</button></form><a class="button" href="/?page=edit">+ New story</a></div><div class="table-wrap"><table><thead><tr><th>Story</th><th>Byline</th><th>Published</th><th></th></tr></thead><tbody><% rows.forEach(a=>{ %><tr><td data-label="Story"><a href="/?page=article&id=<%=a.id%>"><%=a.title%></a><% if(a.isSeed){ %><small>READ-ONLY SAMPLE</small><% } %></td><td data-label="Byline"><%=a.author%></td><td data-label="Published"><%=a.date%></td><td data-label="Manage"><a href="/?page=edit&<%=a.isSeed?'copy':'id'%>=<%=a.id%>"><%=a.isSeed?'Copy':'Edit'%> ↗</a></td></tr><% }); %></tbody></table><% if(!rows.length){ %><p>No stories match your search.</p><% } %></div><p class="hint">Up to 30 of your own stories. Samples stay untouched; copy one to try editing.</p>
<% } else if(page==='edit'){ %><form method="post" enctype="multipart/form-data" class="panel editor"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="article"><input type="hidden" name="id" value="<%=entry.id||''%>"><p class="eyebrow"><%=entry.id?'REFINE YOUR STORY':'A BLANK PAGE. A NEW POSSIBILITY.'%></p><label>Headline<input name="title" value="<%=field('title')%>" required maxlength="200"></label><label>The story<textarea name="content" rows="10" maxlength="20000" required><%=field('content')%></textarea></label><div class="form-row"><label>Byline<input name="author" value="<%=field('author')%>" required maxlength="100"></label><label>Publication date<input type="date" name="date" value="<%=field('date')||today%>" required></label></div><label>Story image · JPEG or PNG, up to 2 MB<input type="file" name="image" accept="image/jpeg,image/png"></label><p class="hint">Images are safely resized and compressed for free hosting. Up to 3 images per workspace.</p><% if(entry.image){ %><img class="thumb" src="<%=imageUrl(entry.image)%>" alt="Current story image"><% } %><button>Publish story ↗</button></form>
<% } else if(page==='pages'){ %><div class="toolbar"><h2>The supporting pages.</h2><a class="button" href="/?page=page-edit">+ New page</a></div><div class="table-wrap"><table><thead><tr><th>Page</th><th>URL key</th><th></th></tr></thead><tbody><% rows.forEach(a=>{ %><tr><td data-label="Page"><a href="/?page=content&slug=<%=a.slug%>"><%=a.title%></a><% if(a.isSeed){ %><small>READ-ONLY SAMPLE</small><% } %></td><td data-label="URL key"><%=a.slug%></td><td data-label="Manage"><% if(!a.isSeed){ %><a href="/?page=page-edit&id=<%=a.id%>">Edit ↗</a><% } %></td></tr><% }); %></tbody></table></div><p class="hint">Up to 10 custom pages. The sample About page stays available.</p>
<% } else if(page==='page-edit'){ %><form method="post" enctype="multipart/form-data" class="panel editor"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="page"><input type="hidden" name="id" value="<%=entry.id||''%>"><label>Page title<input name="title" value="<%=field('title')%>" required maxlength="200"></label><label>Heading<input name="heading" value="<%=field('heading')%>" required maxlength="200"></label><label>Keywords<input name="keywords" value="<%=field('keywords')%>" required maxlength="300"></label><label>URL key<input name="slug" value="<%=field('slug')%>" required maxlength="100" pattern="[a-z0-9]+(-[a-z0-9]+)*"></label><label>Page content<textarea name="content" rows="9" maxlength="20000" required><%=field('content')%></textarea></label><label>Page image · JPEG or PNG, up to 2 MB<input type="file" name="image" accept="image/jpeg,image/png"></label><% if(entry.image){ %><img class="thumb" src="<%=imageUrl(entry.image)%>" alt="Current page image"><% } %><button>Save page ↗</button></form>
<% } else if(page==='import'){ %><div class="import-grid"><form method="post" enctype="multipart/form-data" class="panel"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="import"><p class="eyebrow">BRING YOUR STORIES</p><h2>Import a collection.</h2><p>CSV columns: title, content, author, date. Up to 30 stories per workspace, 1 MB per import. Dates use YYYY-MM-DD. The whole batch is validated before anything is saved.</p><label>CSV file<input type="file" name="csv" accept=".csv,text/csv" required></label><button>Import stories ↗</button></form><div class="panel"><p class="eyebrow">TAKE THEM WITH YOU</p><h2>Your words,<br>portable.</h2><p>Export your visible stories, including samples, to a CSV file. Images are kept separately. Formula-like text is made safe for spreadsheet readers.</p><a class="button" href="/export.php">Download CSV ↗</a></div></div>
<% } else if(page==='users'){ %><div class="toolbar"><h2>The people behind it.</h2><a class="button" href="/?page=user-edit">+ Add person</a></div><div class="people"><% rows.forEach(a=>{ %><article class="panel"><% if(a.image){ %><img class="avatar" src="<%=imageUrl(a.image)%>" alt="Staff profile image"><% } %><span class="initial"><%=a.name.slice(0,1).toUpperCase()%></span><h3><%=a.name%></h3><p><%=a.role%></p><a href="/?page=user-edit&id=<%=a.id%>">Edit profile ↗</a></article><% }); %></div><p class="hint">Up to 5 fictional people. Staff can sign in from this browser's workspace using their own credentials. Password or role changes revoke that person's active sessions.</p><a class="read-link" href="/api.php?type=users">View people JSON ↗</a>
<% } else { %><form method="post" enctype="multipart/form-data" class="panel editor"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="user"><input type="hidden" name="id" value="<%=entry.id||''%>"><label>Username<input name="name" value="<%=field('name')%>" required minlength="3" maxlength="60" autocomplete="off"></label><label><%=entry.id?'New password · leave blank to keep current':'Password · at least 12 characters'%><input type="password" name="password" <%=entry.id?'':'required'%> minlength="12" maxlength="256" autocomplete="new-password"></label><label>Role<select name="role"><option value="editor">Editor</option><option value="admin" <%=entry.role==='admin'?'selected':''%>>Administrator</option></select></label><label>Profile image · JPEG or PNG, up to 2 MB<input type="file" name="image" accept="image/jpeg,image/png"></label><button>Save profile ↗</button></form><% } %>
</section></div>
<% } else { %><section class="article"><p class="eyebrow">LET'S GET YOU BACK TO THE STORY.</p><h1>A small<br><em>interruption.</em></h1><p>Use the navigation to return to your workspace, or start a fresh demo if yours has expired.</p><a class="button" href="/">Back to the publication ↗</a></section><% } %>
</main><footer><a class="brand" href="/" aria-label="The Edit home">THE EDIT<span>INDEPENDENT IDEAS / 01</span></a><p>Ideas worth keeping.<br>Stories worth sharing.</p><small>Fictional publication · Restored from Andres’s advanced PHP coursework<br>Hosted edition: Node.js + Cosmos DB · Original PHP edition preserved</small></footer></body></html>
