<% const entry=item||{}; const field=(name)=>form[name]??entry[name]??''; const isDesk=['desk','edit','pages','page-edit','import','users','user-edit'].includes(page); %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="A fictional publication and a working editorial CMS with isolated demo workspaces."><title>The Edit · Stories, thoughtfully published</title><link rel="stylesheet" href="/style.css"></head><body>
<a class="skip-link" href="#main">Skip to content</a><div class="topline"><span>INDEPENDENT IDEAS. SHARED WELL.</span><span>RESTORED COURSEWORK · FICTIONAL DEMO</span></div><header><a class="brand" href="/">The Edit<span>01</span></a><nav aria-label="Main navigation"><a href="/">Latest stories</a><a href="/?page=content&slug=about">About</a><a href="/?page=widget">News widget</a><a class="nav-button" href="/?page=desk"><%=user?'Editorial desk ↗':'Try the editorial desk ↗'%></a></nav></header>
<main id="main"><% if(error){ %><p class="notice error" role="alert"><%=error%></p><% } %><% if(notice){ %><p class="notice" role="status"><%=notice%></p><% } %>
<% if(user){ %><div class="workspace-note"><span>PRIVATE DEMO WORKSPACE · <%=user.name%> / <%=user.role%></span><span>Automatically clears <time datetime="<%=expiry%>"><%=expiry.replace('T',' ').slice(0,16)%> UTC</time></span></div><% } %>
<% if(page==='home'){const lead=articles[0]; %><section class="masthead"><p class="eyebrow">THE EVERYDAY, RECONSIDERED.</p><h1>Worth a closer <em>look.</em></h1><div class="edition"><span>DESIGN / CULTURE / COMMUNITY</span><span>EDITION 001 — THE OPENING ISSUE</span></div></section><% if(lead){ %><section class="lead"><div class="poster" aria-hidden="true"><div class="poster-frame"><span>A NEW<br>PERSPECTIVE.</span><div class="sphere"></div><small>LOOK AGAIN. THERE’S MORE HERE.</small></div></div><div class="lead-copy"><p class="eyebrow">THE BIG READ / 01</p><h2><a href="/?page=article&id=<%=lead.id%>"><%=lead.title%></a></h2><p><%=lead.content.replace(/\n/g,' ').slice(0,165)%>…</p><a class="read-link" href="/?page=article&id=<%=lead.id%>">Read the story <b>↗</b></a><span class="byline"><%=lead.author%> · <%=lead.date%></span></div></section><% } %><section class="section"><div class="section-title"><h2>The latest.</h2><span>A FEW GOOD THINGS TO THINK ABOUT.</span></div><div class="story-grid"><% articles.slice(1).forEach((a,i)=>{ %><article><div class="mini-art art-<%=i%2%>" aria-hidden="true"><span><%=i%2?'Aa':'✳'%></span></div><p class="eyebrow">NOTES & OBSERVATIONS</p><h3><a href="/?page=article&id=<%=a.id%>"><%=a.title%></a></h3><p class="byline"><%=a.author%> · <%=a.date%></p></article><% }); %></div></section><section class="try-desk"><p class="eyebrow">THERE'S A WORKING CMS BEHIND THE STORIES.</p><h2>Make the next issue yours.</h2><p>Create an isolated demo workspace, write a story, add a page, invite fictional staff, and take your words with you as CSV. Your data expires after 96 hours. The sample stories stay.</p><a class="button" href="/?page=<%=hasWorkspace?'login':'start'%>"><%=hasWorkspace?'Return to your workspace':'Start an editorial workspace'%> ↗</a></section>
<% } else if(page==='article'){ %><article class="article"><p class="eyebrow">THE EDIT / STORIES<%=entry.isSeed?' / READ-ONLY SAMPLE':''%></p><h1><%=entry.title%></h1><p class="byline">BY <%=entry.author%> · <%=entry.date%></p><% if(entry.image){ %><img src="<%=imageUrl(entry.image)%>" alt="Editorial image"><% } %><div class="body-copy preserved-text"><%=entry.content%></div><% if(user){ %><a class="read-link" href="/?page=edit&<%=entry.isSeed?'copy':'id'%>=<%=entry.id%>"><%=entry.isSeed?'Copy to workspace':'Edit story'%> ↗</a><% } %></article>
<% } else if(page==='content'){ %><article class="article"><p class="eyebrow"><%=entry.title%><%=entry.isSeed?' / READ-ONLY SAMPLE':''%></p><h1><%=entry.heading%></h1><% if(entry.image){ %><img src="<%=imageUrl(entry.image)%>" alt="Editorial image"><% } %><div class="body-copy preserved-text"><%=entry.content%></div></article>
<% } else if(page==='widget'){ %><section class="article"><p class="eyebrow">THE REUSABLE NEWS WIDGET</p><h1>Fresh from<br><em>the desk.</em></h1><div class="widget"><% articles.slice(0,5).forEach(a=>{ %><a href="/?page=article&id=<%=a.id%>"><small><%=a.date%></small><h3><%=a.title%> ↗</h3></a><% }); %></div><p>Also available as <a class="read-link" href="/api.php?type=articles">structured JSON ↗</a></p></section>
<% } else if(page==='login'||page==='start'){const starting=page==='start'; %><section class="login-layout"><div><p class="eyebrow">BEHIND THE BYLINES</p><h1>Good stories<br>start <em>here.</em></h1><p>Your space to write, publish and keep everything in order.</p><div class="demo-explanation"><strong>Your own corner of the newsroom.</strong><p>Each visitor gets an isolated workspace. Only people you create inside your workspace can sign in to it. Use fictional details; this is a public portfolio demo.</p><p>Your workspace, accounts, sessions and uploads clear 96 hours after creation. Saving or signing in does not extend that deadline. The original sample stories are read-only and remain available.</p></div></div><div><% if(starting||hasWorkspace){ %><form method="post" class="panel"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="<%=starting?'start':'login'%>"><h2><%=starting?'Your first edition.':'Welcome back.'%></h2><label>Username<input name="name" required minlength="3" maxlength="60" autocomplete="username"></label><label>Password<input type="password" name="password" required minlength="12" maxlength="256" autocomplete="<%=starting?'new-password':'current-password'%>"></label><% if(starting){ %><p class="hint">Choose a unique demo password with at least 12 characters. This creates your workspace administrator. You can add editor accounts from the People screen.</p><% } %><button><%=starting?'Create my workspace':'Open the desk'%> ↗</button></form><% } else { %><div class="panel"><h2>A blank page awaits.</h2><p>No active workspace was found in this browser.</p><a class="button" href="/?page=start">Start a demo workspace ↗</a></div><% } %><p class="hint"><% if(starting&&hasWorkspace){ %>Starting another workspace does not delete the previous one, but this browser will switch to the new workspace.<% } else if(!starting&&hasWorkspace){ %>Forgot the demo credentials? <a href="/?page=start">Start a fresh workspace</a>. Existing data still expires at its original deadline.<% } %></p></div></section>
<% } else if(isDesk){ %><section class="desk-heading"><div><p class="eyebrow">THE EDIT / WORKSPACE</p><h1>Editorial <em>desk.</em></h1></div><form method="post"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="logout"><button class="quiet">Sign out ↗</button></form></section><nav class="desk-nav" aria-label="Workspace navigation"><a href="/?page=desk">Stories</a><a href="/?page=pages">Pages</a><a href="/?page=import">Import & export</a><% if(user.role==='admin'){ %><a href="/?page=users">People</a><% } %></nav>
<% if(page==='desk'){ %><div class="toolbar"><form method="get"><input type="hidden" name="page" value="desk"><label class="sr-only" for="search">Search stories</label><input id="search" name="search" placeholder="Search title or author" value="<%=search%>" maxlength="200"><label class="sr-only" for="sort">Sort stories</label><select id="sort" name="sort"><option value="newest">Newest first</option><option value="oldest" <%=sort==='oldest'?'selected':''%>>Oldest first</option></select><button class="quiet">Search</button></form><a class="button" href="/?page=edit">+ New story</a></div><div class="table-wrap"><table><thead><tr><th>Story</th><th>Byline</th><th>Published</th><th></th></tr></thead><tbody><% rows.forEach(a=>{ %><tr><td><a href="/?page=article&id=<%=a.id%>"><%=a.title%></a><% if(a.isSeed){ %><small>READ-ONLY SAMPLE</small><% } %></td><td><%=a.author%></td><td><%=a.date%></td><td><a href="/?page=edit&<%=a.isSeed?'copy':'id'%>=<%=a.id%>"><%=a.isSeed?'Copy':'Edit'%> ↗</a></td></tr><% }); %></tbody></table><% if(!rows.length){ %><p>No stories match your search.</p><% } %></div><p class="hint">Up to 30 of your own stories. Samples stay untouched; copy one to try editing.</p>
<% } else if(page==='edit'){ %><form method="post" enctype="multipart/form-data" class="panel editor"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="article"><input type="hidden" name="id" value="<%=entry.id||''%>"><p class="eyebrow"><%=entry.id?'REFINE YOUR STORY':'A BLANK PAGE. A NEW POSSIBILITY.'%></p><label>Headline<input name="title" value="<%=field('title')%>" required maxlength="200"></label><label>The story<textarea name="content" rows="10" maxlength="20000" required><%=field('content')%></textarea></label><div class="form-row"><label>Byline<input name="author" value="<%=field('author')%>" required maxlength="100"></label><label>Publication date<input type="date" name="date" value="<%=field('date')||today%>" required></label></div><label>Story image · JPEG or PNG, up to 2 MB<input type="file" name="image" accept="image/jpeg,image/png"></label><p class="hint">Images are safely resized and compressed for free hosting. Up to 3 images per workspace.</p><% if(entry.image){ %><img class="thumb" src="<%=imageUrl(entry.image)%>" alt="Current story image"><% } %><button>Publish story ↗</button></form>
<% } else if(page==='pages'){ %><div class="toolbar"><h2>The supporting pages.</h2><a class="button" href="/?page=page-edit">+ New page</a></div><div class="table-wrap"><table><thead><tr><th>Page</th><th>URL key</th><th></th></tr></thead><tbody><% rows.forEach(a=>{ %><tr><td><a href="/?page=content&slug=<%=a.slug%>"><%=a.title%></a><% if(a.isSeed){ %><small>READ-ONLY SAMPLE</small><% } %></td><td><%=a.slug%></td><td><% if(!a.isSeed){ %><a href="/?page=page-edit&id=<%=a.id%>">Edit ↗</a><% } %></td></tr><% }); %></tbody></table></div><p class="hint">Up to 10 custom pages. The sample About page stays available.</p>
<% } else if(page==='page-edit'){ %><form method="post" enctype="multipart/form-data" class="panel editor"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="page"><input type="hidden" name="id" value="<%=entry.id||''%>"><label>Page title<input name="title" value="<%=field('title')%>" required maxlength="200"></label><label>Heading<input name="heading" value="<%=field('heading')%>" required maxlength="200"></label><label>Keywords<input name="keywords" value="<%=field('keywords')%>" required maxlength="300"></label><label>URL key<input name="slug" value="<%=field('slug')%>" required maxlength="100" pattern="[a-z0-9]+(-[a-z0-9]+)*"></label><label>Page content<textarea name="content" rows="9" maxlength="20000" required><%=field('content')%></textarea></label><label>Page image · JPEG or PNG, up to 2 MB<input type="file" name="image" accept="image/jpeg,image/png"></label><% if(entry.image){ %><img class="thumb" src="<%=imageUrl(entry.image)%>" alt="Current page image"><% } %><button>Save page ↗</button></form>
<% } else if(page==='import'){ %><div class="import-grid"><form method="post" enctype="multipart/form-data" class="panel"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="import"><p class="eyebrow">BRING YOUR STORIES</p><h2>Import a collection.</h2><p>CSV columns: title, content, author, date. Up to 30 stories per workspace, 1 MB per import. Dates use YYYY-MM-DD. The whole batch is validated before anything is saved.</p><label>CSV file<input type="file" name="csv" accept=".csv,text/csv" required></label><button>Import stories ↗</button></form><div class="panel"><p class="eyebrow">TAKE THEM WITH YOU</p><h2>Your words,<br>portable.</h2><p>Export your visible stories, including samples, to a CSV file. Images are kept separately. Formula-like text is made safe for spreadsheet readers.</p><a class="button" href="/export.php">Download CSV ↗</a></div></div>
<% } else if(page==='users'){ %><div class="toolbar"><h2>The people behind it.</h2><a class="button" href="/?page=user-edit">+ Add person</a></div><div class="people"><% rows.forEach(a=>{ %><article class="panel"><% if(a.image){ %><img class="avatar" src="<%=imageUrl(a.image)%>" alt="Staff profile image"><% } %><span class="initial"><%=a.name.slice(0,1).toUpperCase()%></span><h3><%=a.name%></h3><p><%=a.role%></p><a href="/?page=user-edit&id=<%=a.id%>">Edit profile ↗</a></article><% }); %></div><p class="hint">Up to 5 fictional people. Staff can sign in from this browser's workspace using their own credentials. Password or role changes revoke that person's active sessions.</p><a class="read-link" href="/api.php?type=users">View people JSON ↗</a>
<% } else { %><form method="post" enctype="multipart/form-data" class="panel editor"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="user"><input type="hidden" name="id" value="<%=entry.id||''%>"><label>Username<input name="name" value="<%=field('name')%>" required minlength="3" maxlength="60" autocomplete="off"></label><label><%=entry.id?'New password · leave blank to keep current':'Password · at least 12 characters'%><input type="password" name="password" <%=entry.id?'':'required'%> minlength="12" maxlength="256" autocomplete="new-password"></label><label>Role<select name="role"><option value="editor">Editor</option><option value="admin" <%=entry.role==='admin'?'selected':''%>>Administrator</option></select></label><label>Profile image · JPEG or PNG, up to 2 MB<input type="file" name="image" accept="image/jpeg,image/png"></label><button>Save profile ↗</button></form><% } %>
<% } else { %><section class="article"><p class="eyebrow">LET'S GET YOU BACK TO THE STORY.</p><h1>A small<br><em>interruption.</em></h1><p>Use the navigation to return to your workspace, or start a fresh demo if yours has expired.</p><a class="button" href="/">Back to the publication ↗</a></section><% } %>
</main><footer><a class="brand" href="/">The Edit<span>01</span></a><p>Ideas worth keeping.<br>Stories worth sharing.</p><small>Fictional publication · Restored from Andres’s advanced PHP coursework<br>Hosted edition: Node.js + Cosmos DB · Original PHP edition preserved</small></footer></body></html>
